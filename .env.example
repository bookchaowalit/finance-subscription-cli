# Optional: absolute path to Solo Empire monorepo (for OAuth helpers).
# Default: auto-detect ~/solo-empire or parent walk.
# SOLO_EMPIRE_ROOT=/home/you/solo-empire

# Google OAuth is read from Solo Empire .env via infra/scripts/utils/_env.py
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
