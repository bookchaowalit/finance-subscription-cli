{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solo-empire.local/schema/subscription.json",
  "title": "Subscription",
  "type": "object",
  "required": ["id", "merchant", "normalized_name"],
  "properties": {
    "id": { "type": "string" },
    "merchant": { "type": "string" },
    "normalized_name": { "type": "string" },
    "amount": { "type": ["number", "null"] },
    "currency": { "type": ["string", "null"] },
    "billing_cycle": {
      "type": ["string", "null"],
      "enum": ["monthly", "annual", "weekly", "unknown", null]
    },
    "monthly_cost": { "type": ["number", "null"] },
    "annual_cost": { "type": ["number", "null"] },
    "next_renewal_date": { "type": ["string", "null"], "format": "date" },
    "last_payment_date": { "type": ["string", "null"], "format": "date" },
    "status": {
      "type": "string",
      "enum": ["active", "trial", "cancelled", "unknown"]
    },
    "payment_evidence_score": { "type": "number", "minimum": 0, "maximum": 1 },
    "usage_evidence_score": { "type": "number", "minimum": 0, "maximum": 1 },
    "user_value": { "type": ["integer", "null"], "minimum": 1, "maximum": 5 },
    "recommendation": {
      "type": ["string", "null"],
      "enum": ["keep", "downgrade", "cancel", "investigate", "consider_subscribe", null]
    },
    "recommendation_reason": { "type": ["string", "null"] },
    "cancellation_url": { "type": ["string", "null"] },
    "source_message_ids": {
      "type": "array",
      "items": { "type": "string" }
    },
    "evidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidence" }
    },
    "usage_signals": {
      "type": "array",
      "items": { "type": "string" }
    },
    "duplicate_of": { "type": ["string", "null"] },
    "updated_at": { "type": "string" }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "required": ["source_message_id", "event_type", "confidence"],
      "properties": {
        "source_message_id": { "type": "string" },
        "event_type": {
          "type": "string",
          "enum": [
            "invoice",
            "receipt",
            "renewal",
            "trial",
            "price_increase",
            "cancellation_link",
            "payment"
          ]
        },
        "event_date": { "type": ["string", "null"] },
        "amount": { "type": ["number", "null"] },
        "currency": { "type": ["string", "null"] },
        "snippet_evidence": { "type": "string", "maxLength": 280 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "cancellation_url": { "type": ["string", "null"] }
      }
    }
  }
}
